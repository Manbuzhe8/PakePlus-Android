{"name":"eaccdfeeaabba","url":"https://github.com/","showName":"视频回放自动人脸抓拍","appid":"com.eaccdfeeaabba.pakeplus","icon":"","iconPath":"","iconRound":true,"state":true,"single":true,"injectJq":true,"tauriApi":false,"devbug":false,"version":"1.0.0","preview":"Android","platform":["1-1","2-2"],"width":412,"height":915,"desc":"","jsFile":[],"filterCss":"","customJs":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>人脸抓拍视频播放器</title>\n<style>\n  * { box-sizing: border-box; }\n  html, body { height: 100%; margin: 0; }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',\n                 'Microsoft YaHei', sans-serif;\n    background: #0d1117; color: #e6edf3; overflow: hidden;\n  }\n  .app { display: flex; flex-direction: column; height: 100vh; }\n\n  /* ---------- 顶栏 ---------- */\n  .topbar {\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 10px 18px; border-bottom: 1px solid #21262d; background: #161b22;\n    flex-shrink: 0;\n  }\n  .topbar h1 { font-size: 15px; margin: 0; font-weight: 600; letter-spacing: .5px; }\n  .topbar h1 span { color: #00e5a0; }\n\n  .btn {\n    display: inline-flex; align-items: center; gap: 6px;\n    background: #21262d; border: 1px solid #30363d; color: #e6edf3;\n    padding: 7px 14px; border-radius: 8px; font-size: 13px; cursor: pointer;\n    transition: .15s; user-select: none;\n  }\n  .btn:hover { background: #30363d; border-color: #00e5a0; }\n\n  /* ---------- 主体布局 ---------- */\n  .main { flex: 1; display: flex; gap: 14px; padding: 14px; overflow: hidden; min-height: 0; }\n  .player-col { flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 0; }\n  .side-col { width: 300px; display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; min-height: 0; }\n\n  /* ---------- 播放区 ---------- */\n  .stage {\n    position: relative; flex: 1; min-height: 0;\n    background: #000; border-radius: 12px; overflow: hidden;\n    border: 1px solid #21262d;\n  }\n  .media { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }\n  video { width: 100%; height: 100%; display: block; background: #000; }\n  #overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }\n\n  .hint {\n    position: absolute; inset: 0; display: flex; flex-direction: column;\n    align-items: center; justify-content: center; gap: 10px;\n    color: #6e7681; font-size: 14px; pointer-events: none; text-align: center;\n  }\n  .hint .big { font-size: 42px; }\n\n  /* ---------- 控制条 ---------- */\n  .controls {\n    display: flex; align-items: center; gap: 10px;\n    background: #161b22; border: 1px solid #21262d;\n    border-radius: 12px; padding: 10px 14px; flex-shrink: 0; flex-wrap: wrap;\n  }\n  .ctrl {\n    background: #21262d; border: 1px solid #30363d; color: #e6edf3;\n    border-radius: 8px; padding: 8px 12px; font-size: 13px; cursor: pointer;\n    transition: .15s; white-space: nowrap;\n  }\n  .ctrl:hover { background: #30363d; }\n  .ctrl.primary {\n    background: #00e5a0; color: #04241a; border-color: #00e5a0;\n    font-weight: 700; min-width: 46px; font-size: 15px;\n  }\n  .ctrl.primary:hover { background: #26ffb8; }\n\n  .time { font-size: 12px; color: #8b949e; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  #seek {\n    flex: 1; min-width: 120px; -webkit-appearance: none; appearance: none;\n    height: 5px; border-radius: 3px; background: #30363d; outline: none; cursor: pointer;\n  }\n  #seek::-webkit-slider-thumb {\n    -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%;\n    background: #00e5a0; cursor: pointer; box-shadow: 0 0 0 3px rgba(0,229,160,.18);\n  }\n  #seek::-moz-range-thumb {\n    width: 14px; height: 14px; border: none; border-radius: 50%;\n    background: #00e5a0; cursor: pointer;\n  }\n  .rate { font-size: 12px; color: #8b949e; display: flex; align-items: center; gap: 5px; }\n  .rate select {\n    background: #21262d; border: 1px solid #30363d; color: #e6edf3;\n    border-radius: 6px; padding: 4px 6px; font-size: 12px; outline: none;\n  }\n\n  /* ---------- 侧栏卡片 ---------- */\n  .card {\n    background: #161b22; border: 1px solid #21262d; border-radius: 12px;\n    padding: 12px 14px; flex-shrink: 0;\n  }\n  .card.grow { flex: 1; display: flex; flex-direction: column; min-height: 0; }\n  .card-title {\n    font-size: 13px; font-weight: 600; color: #8b949e;\n    display: flex; align-items: center; gap: 8px; margin-bottom: 10px;\n    letter-spacing: .5px;\n  }\n  .count {\n    background: #00e5a0; color: #04241a; border-radius: 10px;\n    padding: 1px 8px; font-size: 11px; font-weight: 700;\n  }\n  .mini {\n    margin-left: auto; background: transparent; border: 1px solid #30363d;\n    color: #8b949e; border-radius: 6px; font-size: 11px; padding: 3px 8px;\n    cursor: pointer;\n  }\n  .mini:hover { color: #ff7b72; border-color: #ff7b72; }\n\n  .row {\n    display: flex; align-items: center; justify-content: space-between;\n    font-size: 12.5px; color: #c9d1d9; padding: 6px 0; gap: 10px;\n  }\n  .row span b { color: #00e5a0; font-variant-numeric: tabular-nums; }\n  .row input[type=range] {\n    -webkit-appearance: none; appearance: none; width: 110px; height: 4px;\n    border-radius: 2px; background: #30363d; outline: none; cursor: pointer;\n  }\n  .row input[type=range]::-webkit-slider-thumb {\n    -webkit-appearance: none; width: 13px; height: 13px; border-radius: 50%;\n    background: #00e5a0; cursor: pointer;\n  }\n  .row input[type=range]::-moz-range-thumb {\n    width: 13px; height: 13px; border: none; border-radius: 50%; background: #00e5a0;\n  }\n  .row input[type=checkbox] {\n    width: 36px; height: 20px; -webkit-appearance: none; appearance: none;\n    background: #30363d; border-radius: 10px; position: relative;\n    cursor: pointer; outline: none; transition: .2s;\n  }\n  .row input[type=checkbox]::after {\n    content: ''; position: absolute; width: 16px; height: 16px; border-radius: 50%;\n    background: #8b949e; top: 2px; left: 2px; transition: .2s;\n  }\n  .row input[type=checkbox]:checked { background: #00e5a0; }\n  .row input[type=checkbox]:checked::after { left: 18px; background: #04241a; }\n  .status span:last-child { color: #d29922; font-weight: 600; }\n  .status span:last-child.ok { color: #00e5a0; }\n  .status span:last-child.err { color: #ff7b72; }\n\n  /* ---------- 抓拍列表 ---------- */\n  .captures {\n    flex: 1; overflow-y: auto; display: grid; gap: 8px;\n    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));\n    align-content: start; padding-right: 4px;\n  }\n  .captures::-webkit-scrollbar { width: 6px; }\n  .captures::-webkit-scrollbar-thumb { background: #30363d; border-radius: 3px; }\n  .captures::-webkit-scrollbar-track { background: transparent; }\n\n  .empty {\n    grid-column: 1 / -1; color: #6e7681; font-size: 12px;\n    text-align: center; padding: 24px 10px; line-height: 1.7;\n  }\n\n  .cap {\n    position: relative; border-radius: 8px; overflow: hidden;\n    background: #0d1117; border: 1px solid #21262d; cursor: pointer;\n    transition: .15s; animation: pop .25s ease;\n  }\n  @keyframes pop { from { transform: scale(.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }\n  .cap:hover { border-color: #00e5a0; transform: translateY(-2px); }\n  .cap img { width: 100%; display: block; aspect-ratio: 1; object-fit: cover; }\n  .cap-meta {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 3px 5px; font-size: 10px; color: #8b949e;\n    font-variant-numeric: tabular-nums; background: #161b22;\n  }\n  .cap-score { color: #00e5a0; }\n  .cap-dl {\n    position: absolute; top: 4px; right: 4px; width: 22px; height: 22px;\n    border: none; border-radius: 6px; background: rgba(0,0,0,.6);\n    color: #e6edf3; cursor: pointer; font-size: 11px; line-height: 1;\n    opacity: 0; transition: .15s; padding: 0;\n  }\n  .cap:hover .cap-dl { opacity: 1; }\n  .cap-dl:hover { background: #00e5a0; color: #04241a; }\n\n  /* ---------- 响应式 ---------- */\n  @media (max-width: 860px) {\n    .main { flex-direction: column; overflow-y: auto; }\n    .side-col { width: 100%; flex-shrink: 0; }\n    .card.grow { height: 220px; flex: none; }\n    .stage { min-height: 42vh; }\n    .app { height: auto; min-height: 100vh; overflow-y: auto; }\n    body { overflow: auto; }\n  }\n</style>\n</head>\n<body>\n<div class=\"app\">\n\n  <header class=\"topbar\">\n    <h1>🎬 人脸抓拍<span>播放器</span></h1>\n    <label class=\"btn\">\n      📁 选择视频\n      <input type=\"file\" id=\"fileInput\" accept=\"video/*\" hidden>\n    </label>\n  </header>\n\n  <main class=\"main\">\n    <section class=\"player-col\">\n      <div class=\"stage\" id=\"stage\">\n        <div class=\"media\" id=\"media\">\n          <video id=\"video\" playsinline></video>\n          <canvas id=\"overlay\"></canvas>\n        </div>\n        <div class=\"hint\" id=\"hint\">\n          <div class=\"big\">🎥</div>\n          <div>点击右上角「选择视频」，或直接把视频拖到这里</div>\n        </div>\n      </div>\n\n      <div class=\"controls\">\n        <button class=\"ctrl\" id=\"backBtn\" title=\"快退 10 秒 (←)\">⏪ 10s</button>\n        <button class=\"ctrl primary\" id=\"playBtn\" title=\"播放/暂停 (空格)\">▶</button>\n        <button class=\"ctrl\" id=\"fwdBtn\" title=\"快进 10 秒 (→)\">10s ⏩</button>\n        <span class=\"time\">\n          <span id=\"curTime\">00:00</span> / <span id=\"durTime\">00:00</span>\n        </span>\n        <input type=\"range\" id=\"seek\" min=\"0\" max=\"100\" step=\"0.01\" value=\"0\">\n        <span class=\"rate\">\n          倍速\n          <select id=\"rateSel\">\n            <option value=\"0.5\">0.5x</option>\n            <option value=\"1\" selected>1x</option>\n            <option value=\"1.5\">1.5x</option>\n            <option value=\"2\">2x</option>\n          </select>\n        </span>\n      </div>\n    </section>\n\n    <aside class=\"side-col\">\n      <div class=\"card\">\n        <div class=\"card-title\">⚙️ 抓拍设置</div>\n\n        <div class=\"row\">\n          <span>启用人脸检测</span>\n          <input type=\"checkbox\" id=\"detectToggle\" checked>\n        </div>\n\n        <div class=\"row\">\n          <span>抓拍间隔 <b id=\"intervalVal\">1.5</b>s</span>\n          <input type=\"range\" id=\"intervalRange\" min=\"0.3\" max=\"5\" step=\"0.1\" value=\"1.5\">\n        </div>\n\n        <div class=\"row\">\n          <span>识别灵敏度 <b id=\"scoreVal\">0.50</b></span>\n          <input type=\"range\" id=\"scoreRange\" min=\"0.2\" max=\"0.9\" step=\"0.05\" value=\"0.5\">\n        </div>\n\n        <div class=\"row status\">\n          <span>模型状态</span>\n          <span id=\"status\">加载中…</span>\n        </div>\n      </div>\n\n      <div class=\"card grow\">\n        <div class=\"card-title\">\n          📸 抓拍记录 <span class=\"count\" id=\"capCount\">0</span>\n          <button class=\"mini\" id=\"clearBtn\">清空</button>\n        </div>\n        <div class=\"captures\" id=\"captures\">\n          <div class=\"empty\" id=\"emptyCap\">播放视频后<br>检测到人脸会自动抓拍<br>点击缩略图可跳转到该时间点</div>\n        </div>\n      </div>\n    </aside>\n  </main>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  /* ======================= 元素引用 ======================= */\n  const $ = id => document.getElementById(id);\n  const stage        = $('stage');\n  const media        = $('media');\n  const video        = $('video');\n  const overlay      = $('overlay');\n  const octx         = overlay.getContext('2d');\n  const hint         = $('hint');\n  const playBtn      = $('playBtn');\n  const backBtn      = $('backBtn');\n  const fwdBtn       = $('fwdBtn');\n  const seek         = $('seek');\n  const curTimeEl    = $('curTime');\n  const durTimeEl    = $('durTime');\n  const rateSel      = $('rateSel');\n  const fileInput    = $('fileInput');\n  const detectToggle = $('detectToggle');\n  const intervalRange= $('intervalRange');\n  const intervalVal  = $('intervalVal');\n  const scoreRange   = $('scoreRange');\n  const scoreVal     = $('scoreVal');\n  const statusEl     = $('status');\n  const capturesEl   = $('captures');\n  const capCountEl   = $('capCount');\n  const clearBtn     = $('clearBtn');\n  const emptyCap     = $('emptyCap');\n\n  /* ======================= 全局状态 ======================= */\n  let detectorReady   = false;   // 模型是否加载完成\n  let busy            = false;   // 防止检测任务堆积\n  let rafId           = null;\n  let lastDetectTs    = 0;\n  let lastCaptureTs   = 0;\n  let captureInterval = 1500;    // 两次抓拍的最小间隔(ms)\n  let scoreThreshold  = 0.5;\n  let recentFaces     = [];      // { box, ts } 用于去重\n  let captureCount    = 0;\n  let seeking         = false;\n\n  const DETECT_FPS = 6;          // 每秒最多检测次数\n  const JUMP_SEC   = 10;         // 快进快退秒数\n\n  /* ======================= 工具函数 ======================= */\n  const fmtTime = s => {\n    if (!isFinite(s) || s < 0) s = 0;\n    s = Math.floor(s);\n    return String(Math.floor(s / 60)).padStart(2, '0') + ':' +\n           String(s % 60).padStart(2, '0');\n  };\n\n  function iou(a, b) {\n    const x1 = Math.max(a.x, b.x), y1 = Math.max(a.y, b.y);\n    const x2 = Math.min(a.x + a.width,  b.x + b.width);\n    const y2 = Math.min(a.y + a.height, b.y + b.height);\n    const inter = Math.max(0, x2 - x1) * Math.max(0, y2 - y1);\n    const union = a.width * a.height + b.width * b.height - inter;\n    return union > 0 ? inter / union : 0;\n  }\n\n  const loadScript = src => new Promise((res, rej) => {\n    const s = document.createElement('script');\n    s.src = src;\n    s.onload = res;\n    s.onerror = () => rej(new Error('load fail: ' + src));\n    document.head.appendChild(s);\n  });\n\n  const withTimeout = (p, ms) => Promise.race([\n    p,\n    new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), ms))\n  ]);\n\n  /* ======================= 画布布局 ======================= */\n  function layout() {\n    const vw = video.videoWidth  || 16;\n    const vh = video.videoHeight || 9;\n    const cw = stage.clientWidth;\n    const ch = stage.clientHeight;\n    if (!cw || !ch) return;\n\n    const scale = Math.min(cw / vw, ch / vh);\n    media.style.width  = Math.round(vw * scale) + 'px';\n    media.style.height = Math.round(vh * scale) + 'px';\n\n    if (overlay.width !== vw || overlay.height !== vh) {\n      overlay.width  = vw;\n      overlay.height = vh;\n    }\n  }\n\n  if (window.ResizeObserver) new ResizeObserver(layout).observe(stage);\n  window.addEventListener('resize', layout);\n\n  /* ======================= 播放控制 ======================= */\n  function togglePlay() {\n    if (!video.src) return;\n    if (video.paused) video.play().catch(() => {});\n    else video.pause();\n  }\n\n  playBtn.addEventListener('click', togglePlay);\n\n  backBtn.addEventListener('click', () => {\n    video.currentTime = Math.max(0, video.currentTime - JUMP_SEC);\n  });\n\n  fwdBtn.addEventListener('click', () => {\n    video.currentTime = Math.min(video.duration || 0, video.currentTime + JUMP_SEC);\n  });\n\n  seek.addEventListener('input', () => {\n    seeking = true;\n    curTimeEl.textContent = fmtTime(seek.value / 100 * (video.duration || 0));\n  });\n\n  seek.addEventListener('change', () => {\n    video.currentTime = seek.value / 100 * (video.duration || 0);\n    seeking = false;\n  });\n\n  rateSel.addEventListener('change', () => {\n    video.playbackRate = parseFloat(rateSel.value);\n  });\n\n  document.addEventListener('keydown', e => {\n    const t = e.target;\n    if (t && (t.tagName === 'INPUT' || t.tagName === 'SELECT' || t.tagName === 'TEXTAREA')) return;\n    if (e.code === 'Space')      { e.preventDefault(); togglePlay(); }\n    if (e.code === 'ArrowRight') { video.currentTime = Math.min(video.duration || 0, video.currentTime + JUMP_SEC); }\n    if (e.code === 'ArrowLeft')  { video.currentTime = Math.max(0, video.currentTime - JUMP_SEC); }\n  });\n\n  /* ======================= 视频加载 ======================= */\n  video.addEventListener('loadedmetadata', () => {\n    hint.style.display = 'none';\n    layout();\n    durTimeEl.textContent = fmtTime(video.duration);\n  });\n\n  video.addEventListener('timeupdate', () => {\n    if (!seeking) {\n      seek.value = video.duration ? (video.currentTime / video.duration) * 100 : 0;\n    }\n    curTimeEl.textContent = fmtTime(video.currentTime);\n  });\n\n  video.addEventListener('play',  () => {\n    playBtn.textContent = '⏸';\n    startLoop();\n  });\n  video.addEventListener('pause', () => { playBtn.textContent = '▶'; });\n  video.addEventListener('ended', () => { playBtn.textContent = '▶'; });\n\n  function openFile(file) {\n    if (!file || !file.type.startsWith('video/')) return;\n    if (video.src) URL.revokeObjectURL(video.src);\n    video.src = URL.createObjectURL(file);\n    video.load();\n    video.play().catch(() => {});\n  }\n\n  fileInput.addEventListener('change', e => openFile(e.target.files[0]));\n\n  document.addEventListener('dragover', e => e.preventDefault());\n  document.addEventListener('drop', e => {\n    e.preventDefault();\n    openFile(e.dataTransfer.files[0]);\n  });\n\n  /* ======================= 设置项 ======================= */\n  detectToggle.addEventListener('change', () => {\n    if (!detectToggle.checked) {\n      octx.clearRect(0, 0, overlay.width, overlay.height);\n    }\n  });\n\n  intervalRange.addEventListener('input', () => {\n    captureInterval = parseFloat(intervalRange.value) * 1000;\n    intervalVal.textContent = intervalRange.value;\n  });\n\n  scoreRange.addEventListener('input', () => {\n    scoreThreshold = parseFloat(scoreRange.value);\n    scoreVal.textContent = scoreThreshold.toFixed(2);\n  });\n\n  clearBtn.addEventListener('click', () => {\n    capturesEl.querySelectorAll('.cap').forEach(n => n.remove());\n    captureCount = 0;\n    capCountEl.textContent = '0';\n    emptyCap.style.display = '';\n  });\n\n  /* ======================= 人脸检测循环 ======================= */\n  function startLoop() {\n    if (rafId === null) rafId = requestAnimationFrame(loop);\n  }\n\n  async function loop(ts) {\n    rafId = requestAnimationFrame(loop);\n\n    if (!detectorReady || !detectToggle.checked) return;\n    if (video.paused || video.ended || video.readyState < 2) return;\n    if (busy) return;\n    if (ts - lastDetectTs < 1000 / DETECT_FPS) return;\n\n    lastDetectTs = ts;\n    busy = true;\n\n    try {\n      const options = new faceapi.TinyFaceDetectorOptions({\n        inputSize: 320,\n        scoreThreshold: scoreThreshold\n      });\n      const results = await faceapi.detectAllFaces(video, options);\n\n      drawBoxes(results);\n      handleCapture(results);\n    } catch (err) {\n      console.error('[detect error]', err);\n    } finally {\n      busy = false;\n    }\n  }\n\n  /* ======================= 绘制人脸框 ======================= */\n  function drawBoxes(results) {\n    octx.clearRect(0, 0, overlay.width, overlay.height);\n    if (!results.length) return;\n\n    const lw = Math.max(2, overlay.width / 400);\n    const fs = Math.max(12, overlay.width / 55);\n\n    octx.lineWidth   = lw;\n    octx.strokeStyle = '#00e5a0';\n    octx.font        = `600 ${fs}px -apple-system, sans-serif`;\n    octx.textBaseline = 'middle';\n\n    for (const r of results) {\n      const b = r.box;\n      octx.strokeRect(b.x, b.y, b.width, b.height);\n\n      // 左上角标签\n      const label = Math.round(r.score * 100) + '%';\n      const tw = octx.measureText(label).width + fs * 0.8;\n      const th = fs * 1.5;\n      const ly = Math.max(0, b.y - th);\n\n      octx.fillStyle = 'rgba(0,229,160,.9)';\n      octx.fillRect(b.x, ly, tw, th);\n      octx.fillStyle = '#04241a';\n      octx.fillText(label, b.x + fs * 0.4, ly + th / 2);\n    }\n  }\n\n  /* ======================= 抓拍处理 ======================= */\n  function handleCapture(results) {\n    const now = performance.now();\n\n    // 清理过期的人脸记录\n    recentFaces = recentFaces.filter(f => now - f.ts < 4000);\n\n    // 全局冷却\n    if (now - lastCaptureTs < captureInterval) return;\n\n    // 选一个：尺寸够大、且不是刚抓过的同一张脸、置信度最高\n    const target = results\n      .filter(r => r.box.width >= 40 && !isDuplicate(r.box, now))\n      .sort((a, b) => b.score - a.score)[0];\n\n    if (!target) return;\n\n    lastCaptureTs = now;\n    recentFaces.push({ box: Object.assign({}, target.box), ts: now });\n\n    const dataUrl = cropFace(target.box);\n    if (dataUrl) addCapture(dataUrl, video.currentTime, target.score);\n  }\n\n  function isDuplicate(box, now) {\n    return recentFaces.some(f => now - f.ts < 3000 && iou(f.box, box) > 0.4);\n  }\n\n  /** 把人脸区域从当前视频帧裁剪成小图 */\n  function cropFace(box) {\n    const padX = box.width  * 0.30;\n    const padY = box.height * 0.35;\n\n    let sx = Math.max(0, box.x - padX);\n    let sy = Math.max(0, box.y - padY);\n    let sw = Math.min(video.videoWidth  - sx, box.width  + padX * 2);\n    let sh = Math.min(video.videoHeight - sy, box.height + padY * 2);\n\n    if (sw <= 0 || sh <= 0) return null;\n\n    const W = 200;\n    const H = Math.max(1, Math.round(W * sh / sw));\n\n    const c = document.createElement('canvas');\n    c.width = W;\n    c.height = H;\n\n    const cx = c.getContext('2d');\n    cx.drawImage(video, sx, sy, sw, sh, 0, 0, W, H);\n\n    return c.toDataURL('image/jpeg', 0.85);\n  }\n\n  /* ======================= 抓拍列表 UI ======================= */\n  function addCapture(dataUrl, time, score) {\n    emptyCap.style.display = 'none';\n\n    const t = fmtTime(time);\n    const el = document.createElement('div');\n    el.className = 'cap';\n    el.title = `点击跳转到 ${t}`;\n\n    const img = document.createElement('img');\n    img.src = dataUrl;\n    img.alt = '抓拍';\n\n    const meta = document.createElement('div');\n    meta.className = 'cap-meta';\n    meta.innerHTML = `<span>${t}</span><span class=\"cap-score\">${Math.round(score * 100)}%</span>`;\n\n    const dl = document.createElement('button');\n    dl.className = 'cap-dl';\n    dl.textContent = '⬇';\n    dl.title = '下载这张抓拍';\n    dl.addEventListener('click', e => {\n      e.stopPropagation();\n      const a = document.createElement('a');\n      a.href = dataUrl;\n      a.download = `face_${t.replace(':', 'm')}s.jpg`;\n      a.click();\n    });\n\n    el.addEventListener('click', () => {\n      video.currentTime = time;\n      if (video.paused) video.play().catch(() => {});\n    });\n\n    el.appendChild(img);\n    el.appendChild(meta);\n    el.appendChild(dl);\n    capturesEl.prepend(el);\n\n    captureCount++;\n    capCountEl.textContent = captureCount;\n\n    // 最多保留 200 条\n    const all = capturesEl.querySelectorAll('.cap');\n    if (all.length > 200) all[all.length - 1].remove();\n  }\n\n  /* ======================= 加载 face-api 与模型 ======================= */\n  const SCRIPT_URLS = [\n    'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/dist/face-api.js',\n    'https://unpkg.com/@vladmandic/face-api@1.7.13/dist/face-api.js',\n    'https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js'\n  ];\n\n  const MODEL_URLS = [\n    'https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.13/model/',\n    'https://unpkg.com/@vladmandic/face-api@1.7.13/model/',\n    'https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/weights/'\n  ];\n\n  function setStatus(text, cls) {\n    statusEl.textContent = text;\n    statusEl.className = cls || '';\n  }\n\n  async function ensureFaceApi() {\n    if (window.faceapi) return true;\n    for (const url of SCRIPT_URLS) {\n      try {\n        await withTimeout(loadScript(url), 12000);\n        if (window.faceapi) return true;\n      } catch (e) {\n        console.warn('[face-api] 脚本源失败:', url, e.message);\n      }\n    }\n    return false;\n  }\n\n  async function loadModels() {\n    for (const base of MODEL_URLS) {\n      try {\n        await withTimeout(\n          faceapi.nets.tinyFaceDetector.loadFromUri(base),\n          20000\n        );\n        console.log('[face-api] 模型加载成功:', base);\n        return true;\n      } catch (e) {\n        console.warn('[face-api] 模型源失败:', base, e.message);\n      }\n    }\n    return false;\n  }\n\n  async function init() {\n    setStatus('加载引擎…');\n\n    const hasApi = await ensureFaceApi();\n    if (!hasApi) {\n      setStatus('❌ 引擎加载失败', 'err');\n      console.error('face-api.js 加载失败，请检查网络或改用本地模型文件。');\n      return;\n    }\n\n    setStatus('加载模型…');\n\n    const ok = await loadModels();\n    if (!ok) {\n      setStatus('❌ 模型加载失败', 'err');\n      console.error('模型加载失败。可下载模型文件放到本地，并修改 MODEL_URLS。');\n      return;\n    }\n\n    detectorReady = true;\n    setStatus('✅ 就绪', 'ok');\n\n    // 若视频已在播放，立刻启动检测\n    if (!video.paused) startLoop();\n  }\n\n  // 页面一打开就预加载模型\n  init();\n\n  // 保底：任何情况下都保证渲染循环存在\n  startLoop();\n\n})();\n</script>\n</body>\n</html>","isHtml":false,"htmlPath":"","htmlFiles":[],"prefix":"","pcRepo":"PakePlus","iosRepo":"PakePlus-iOS","androidRepo":"PakePlus-Android","win7Repo":"","versionStr":"web10","more":{"windows":{"label":"eaccdfeeaabba","title":"视频回放自动人脸抓拍","url":"https://github.com/","userAgent":"Mozilla/5.0 (Linux; Android 14; Pixel 6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36","width":412,"height":915,"theme":null,"resizable":true,"fullscreen":false,"maximized":false,"minWidth":400,"minHeight":300,"maxWidth":1920,"maxHeight":1080,"decorations":true,"transparent":false,"titleBarStyle":"Visible","visible":true,"focus":true,"closable":true,"minimizable":true,"maximizable":true,"alwaysOnTop":false,"alwaysOnBottom":false,"center":false,"shadow":true,"skipTaskbar":false,"tabbingIdentifier":null,"parent":null,"dragDropEnabled":true,"browserExtensionsEnabled":false,"devtools":true,"contentProtected":false,"hiddenTitle":false,"incognito":false,"proxyUrl":null,"useHttpsScheme":false,"zoomHotkeysEnabled":false,"acceptFirstMouse":false,"create":false,"backgroundColor":null,"backgroundThrottling":null,"javascriptDisabled":false}},"phone":{"fullScreen":false,"l